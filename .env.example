# Copy this file to .env.local (never committed) and fill in the values.
# In Vercel the same variables are set under Project → Settings → Environment Variables.

# monday API token (server only).
MONDAY_TOKEN=
# Optional: pin a monday.com API version (e.g. 2025-04). Empty = monday's current default.
MONDAY_API_VERSION=

# Access control (api/_auth.js)
# monday account the app belongs to (etoile8 = 30507720). Tokens from any other account are refused.
MONDAY_ACCOUNT_ID=
# From the monday Developer Center → your app → Basic Information. Both are tried to verify the sessionToken.
MONDAY_SIGNING_SECRET=
MONDAY_CLIENT_SECRET=
# Optional: your monday app ID; when set, tokens of other apps are refused.
MONDAY_APP_ID=

# LOCAL ONLY — lets `npm run dev` work outside monday as this user (must be Active in the access list).
# Ignored on Vercel. Never set it in Vercel.
AUTH_DEV_USER_ID=

# Daily check (api/daily-check.js) — Make sends it in the "x-daily-secret" header. Any long random text.
DAILY_CHECK_SECRET=
# Webhook (Make → Gmail) that receives the review report after every daily check.
SALE_REPORT_GMAIL=
# Optional: link to the app used in the review mail (default: https://etoile8.monday.com/custom_objects/18433465002).
APP_URL=
